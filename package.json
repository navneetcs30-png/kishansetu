{
  "name": "kishansetu",
  "private": true,
  "version": "1.0.0",
  "description": "KishanSetu - Unified Agri-Tech Digital Ecosystem connecting Farmers, Consumers, Bulk Buyers, and Administrators",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:vite": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "tsx tests/platformConfig.test.ts && tsx tests/adminAuthDb.test.ts",
    "dev:farmer": "npm --prefix farmer-dashboard run dev",
    "dev:consumer": "npm --prefix agridirect-consumer-dashboard run dev",
    "dev:bulk": "npm --prefix bulk-buyer-dashboard run dev",
    "dev:admin": "npm --prefix admin-dashboard run dev",
    "dev:auth": "npm --prefix \"user-login-&-authentication\" run dev"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
