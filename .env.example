# ==============================================================================
# 🌾 KishanSetu - Environment Configuration
# ==============================================================================

# Server Port
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# ⚡ SUPABASE DATABASE & AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# 1. Create a free project at: https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy "Project URL" and "anon public" API key below:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Service Role Key for server-side elevated admin operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 🤖 GEMINI AI ENGINE (Kisan Sahayak Assistant)
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
